# Copy to .env (gitignored). Used by the V4a naming step when calling a live VLM endpoint.
#
# Free Groq key (open-weight Llama-Vision, no credit card): https://console.groq.com
GROQ_API_KEY=

# Optional: a pool of keys to rotate through when one hits its rate limit (consented team/
# research use, this project only). Either form works; GROQ_API_KEYS takes priority.
# GROQ_API_KEYS=key1,key2,key3
# GROQ_API_KEY_1=
# GROQ_API_KEY_2=

# (optional) generic live VLM endpoint, if you self-host instead of Groq
# VLM_ENDPOINT_URL=
