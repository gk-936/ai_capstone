\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Control-hallucination on confound-free crops across the full tested model roster, synthetic (V4a) vs.\ real chest tube (V4b), extending Figure~\ref {fig:naming_boundary} to the full roster. Llama-4-Scout and Pixtral-12B both fabricate on a majority of clean real-device crops; qwen2.5-vl-7b over-names just as hard (0.74) despite being a larger, newer general model. CheXagent-2-3B's 0.0 on V4b is a taxonomy gap --- its output vocabulary has no device class --- not a passed gate.}}{14}{}\protected@file@percent }
\newlabel{fig:roster}{{9}{14}{}{figure.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Reliance gap vs.\ injected-tag correlation strength $p$ (one training seed per point). Reliance is negligible below $p \approx 0.7$ and climbs steeply above it, reaching the 44pp headline figure at $p=0.95$.}}{14}{}\protected@file@percent }
\newlabel{fig:sweep}{{10}{14}{}{figure.10}{}}
