\@writefile{toc}{\contentsline {subsubsection}{\numberline {\mbox  {IV-D}1}Experiment 1 --- the difficulty curve is a recall cliff, not a hallucination cliff}{8}{}\protected@file@percent }
\citation{lotfinia2026}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Before/after Grad-CAM on the real tube model, produced by a single auditor command (detect$\rightarrow $\allowbreak  mitigate). After DFR last-layer retraining, attention broadens away from the confound-associated region while in-distribution accuracy is preserved (0.96$\rightarrow $0.97 on this single demo run) and worst-group accuracy rises.}}{9}{}\protected@file@percent }
\newlabel{fig:before_after}{{4}{9}{}{figure.4}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {\mbox  {IV-D}2}Experiment 2 --- fabrication is grounded, not blind recitation}{9}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Cross-site AUC change from NIH to PadChest, with 95\% bootstrap CIs where reported. The baseline drop ($-0.192$) is real and Zech-magnitude. Supervised target adaptation ($+0.082$, no CI reported) uses PadChest labels and licenses no mitigation claim. The zero-shot, label-free source-DFR test ($+0.005$, 95\% CI [$-0.018$, $+0.028$]) is the honest test of whether the known source-side shortcut explains the gap: its interval includes zero and excludes a large recovery.}}{10}{}\protected@file@percent }
\newlabel{fig:forest}{{5}{10}{}{figure.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Naming-difficulty (opacity) sweep for the synthetic tag (Table~\ref {tab:difficulty}). Reducing opacity produces a recall cliff for Scout ($0.90 \rightarrow 0.52 \rightarrow 0.03$) while control-hallucination stays flat ($\sim $0.02 Scout, $\sim $0.28--0.32 Pixtral) at every opacity level: faintness makes the model miss the confound, it does not make it invent one.}}{10}{}\protected@file@percent }
\newlabel{fig:difficulty}{{6}{10}{}{figure.6}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Grounding experiment: verdict changes by direction, per dataset/condition/model, at $n = 100$.}}{10}{}\protected@file@percent }
\newlabel{tab:grounding}{{5}{10}{}{table.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Representative synthetic-tag crops across the opacity levels swept in Table~\ref {tab:difficulty} (0.25--1.0), illustrating the visual difficulty gradient underlying the recall cliff in Figure~\ref {fig:difficulty}.}}{11}{}\protected@file@percent }
\newlabel{fig:contactsheet}{{7}{11}{}{figure.7}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {IV-E}}Specialist VLM}{11}{}\protected@file@percent }
\newlabel{sec:specialist}{{\mbox  {IV-E}}{11}{}{subsection.4.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Image-independence (occlusion/swap) study (Table~\ref {tab:grounding}). pos$\rightarrow $neg (named at baseline, not after) is consistent with grounding; neg$\rightarrow $pos is fabrication merely relocated. Within V4b, occluding the tube region drops device-naming far more (61/100 Scout, 66/100 Pixtral) than occluding an equal-area irrelevant region (30/100 Scout, 13/100 Pixtral); the V4a \texttt  {relevant} condition is contaminated by the gray occluder itself tripping the \texttt  {names\_confound} matcher and should be read with that caveat.}}{12}{}\protected@file@percent }
\newlabel{fig:occlusion}{{8}{12}{}{figure.8}{}}
